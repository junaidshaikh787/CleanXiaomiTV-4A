<?xml version="1.0" encoding="utf-8"?>
<!-- Azan screen (AzanActivity): moon, namaz name, its time and the Islamic date, centred over black with a
     soft gold glow; the hint at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/azan_glow">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/azanIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_prayer"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/azan_title"
            android:textColor="#B3F2C879"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.3"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/azanPrayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="76sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 250"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/azanTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#E6FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300" />

        <TextView
            android:id="@+id/azanHijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D9F2C879"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:text="@string/azan_hint"
        android:textColor="#73FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400"
        android:letterSpacing="0.06" />
</FrameLayout>
