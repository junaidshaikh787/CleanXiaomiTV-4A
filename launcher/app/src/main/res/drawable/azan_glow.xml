<?xml version="1.0" encoding="utf-8"?>
<!-- The azan screen's background: a soft gold glow in the middle of black. Drawn once; nothing animates. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="0.5"
                android:centerY="0.45"
                android:startColor="#33F2C879"
                android:centerColor="#0FF2C879"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
